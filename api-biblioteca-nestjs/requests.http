POST {{base}}/leitores
Content-Type: application/json

{
  "nome": "Daniel Alves",
  "matricula": "2026003",
  "email": "daniel-sem-arroba"
}


# =============================================================
# EMPRESTIMOS
# =============================================================

### 29. POST /emprestimos - Ana pega o Dom Casmurro (201)
# REGRA R3: olhe a resposta. A dataPrevista veio com 14 dias depois da
# dataRetirada, e eu não mandei nenhuma data no corpo da requisição.
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 1
}

### 30. POST /emprestimos - ERRO DA REGRA R1 (409, codigo SEM_EXEMPLAR)
# O Dom Casmurro tem 1 exemplar só, e a Ana está com ele desde a requisição 29.
# Então não sobrou exemplar pro Bruno.
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 1,
  "leitorId": 2
}

### 31. DELETE /livros/:id - ERRO DA REGRA R6 (409)
# O Dom Casmurro está emprestado com a Ana, então não pode ser excluído.
DELETE {{base}}/livros/1

### 32. POST /emprestimos - segundo empréstimo da Ana (201)
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 2,
  "leitorId": 1
}

### 33. POST /emprestimos - terceiro empréstimo da Ana (201)
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 3,
  "leitorId": 1
}

### 34. POST /emprestimos - ERRO DA REGRA R2 (409, codigo LIMITE_EMPRESTIMOS)
# A Ana já está com 3 livros em aberto, esse seria o quarto.
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 2,
  "leitorId": 1
}

### 35. POST /emprestimos - erro: o livro 99 não existe (404)
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 99,
  "leitorId": 1
}

### 36. POST /emprestimos - erro: o leitor 99 não existe (404)
POST {{base}}/emprestimos
Content-Type: application/json

{
  "livroId": 2,
  "leitorId": 99
}

### 37. GET /leitores/:id/emprestimos - todos os empréstimos da Ana (200)
GET {{base}}/leitores/1/emprestimos

### 38. GET /leitores/:id/emprestimos - só os que estão em aberto (200)
GET {{base}}/leitores/1/emprestimos?status=aberto

### 39. GET /leitores/:id/emprestimos - erro: leitor não existe (404)
GET {{base}}/leitores/999/emprestimos

### 40. PATCH /emprestimos/:id/devolucao - Ana devolve em dia (200)
# A multa fica em 0 porque não passou da data prevista.
PATCH {{base}}/emprestimos/1/devolucao

### 41. PATCH /emprestimos/:id/devolucao - ERRO DA REGRA R5 (409, codigo JA_DEVOLVIDO)
# Esse empréstimo já foi devolvido na requisição 40.
PATCH {{base}}/emprestimos/1/devolucao

### 42. PATCH /emprestimos/:id/devolucao - erro: empréstimo não existe (404)
PATCH {{base}}/emprestimos/999/devolucao

### 43. DELETE /livros/:id - agora o Dom Casmurro pode ser excluído (204)
# A Ana devolveu na requisição 40, então a regra R6 não barra mais.
DELETE {{base}}/livros/1


# =============================================================
# REGRA R4 - A MULTA DE ATRASO
# =============================================================
#
# A R4 é diferente das outras: ela não devolve erro nenhum, ela calcula um
# valor. Pra ver a multa funcionando eu preciso de um empréstimo atrasado, e a
# API nunca cria um atrasado, porque a regra R3 sempre joga a data prevista
# 14 dias pra frente.
#
# Então, pra testar, rode esse comando no terminal pra puxar a data prevista
# do empréstimo 2 cinco dias pra trás:
#
#   docker exec biblioteca-postgres psql -U postgres -d biblioteca -c "UPDATE emprestimos SET \"dataPrevista\" = CURRENT_DATE - 5 WHERE id = 2;"
#
# Depois rode a requisição abaixo. A resposta vem com "multa": 5, que é
# R$ 1,00 por cada um dos 5 dias de atraso.

### 44. PATCH /emprestimos/:id/devolucao - devolução com 5 dias de atraso (200, multa 5)
PATCH {{base}}/emprestimos/2/devolucao
